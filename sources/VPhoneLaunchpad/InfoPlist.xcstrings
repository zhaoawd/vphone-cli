    "NSLocationUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "vphone-launchpad forwards your location to the guest VM for location simulation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "vphone-launchpad 将此 Mac 的位置转发到客户机虚拟机，用于位置模拟。"
          }
        }
      }
    },
