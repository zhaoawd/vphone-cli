    "%@ is a machine. Choose the folder that contains it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a machine. Choose the folder that contains it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是一台虚拟机。请选择包含它的文件夹。"
          }
        }
      }
    },
    "%@ is not on an APFS volume.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not on an APFS volume."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在 APFS 宗卷上。"
          }
        }
      }
    },
    "%@ is not owned by your user account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not owned by your user account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的所有者不是你的用户账户。"
          }
        }
      }
    },
    "%@ is on a volume that ignores ownership. Select the volume in the Finder, choose File > Get Info, and turn off “Ignore ownership on this volume”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is on a volume that ignores ownership. Select the volume in the Finder, choose File > Get Info, and turn off “Ignore ownership on this volume”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 所在的宗卷忽略了所有权。请在访达中选中该宗卷，选取“文件”>“显示简介”，然后取消勾选“忽略此宗卷上的所有权”。"
          }
        }
      }
    },
