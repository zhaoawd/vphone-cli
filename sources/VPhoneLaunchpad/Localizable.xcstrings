    "vphone-cli reports no progress to Launchpad; the machine shows Exporting… until the archive is written. Cancel Export stops it and removes the partial archive it created.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "vphone-cli reports no progress to Launchpad; the machine shows Exporting… until the archive is written. Cancel Export stops it and removes the partial archive it created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "vphone-cli 不向 Launchpad 报告进度；归档写完之前，虚拟机显示“正在导出…”。“取消导出”会停止导出，并删除本次导出创建的不完整归档。"
          }
        }
      }
    }
  },
  "version": "1.0"
