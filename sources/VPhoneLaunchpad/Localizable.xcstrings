    "vm create --resume refused: the toolchain digest differs from the one in the checkpoint.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "vm create --resume refused: the toolchain digest differs from the one in the checkpoint."
