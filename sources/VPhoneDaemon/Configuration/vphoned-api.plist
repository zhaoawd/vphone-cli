<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.vphone.vphoned.api</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/vphoned-api</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>1</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/var/log/vphoned-api.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/vphoned-api.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>VPHONED_VCAM</key>
		<string>off</string>
	</dict>
</dict>
</plist>
