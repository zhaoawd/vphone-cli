static int checks, failures;
static void check(bool condition, const char *message) {
    checks++;
    if (!condition) { failures++; fprintf(stderr, "FAIL: %s\n", message); }
}
static void write_file(const char *path) {
    int descriptor = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
    assert(descriptor >= 0 && write(descriptor, "fixture", 7) == 7);
    assert(close(descriptor) == 0);
}
int main(int argc, char **argv) {
    assert(argc == 2);
    char alias[4096], other[4096];
    snprintf(cache_directory, sizeof(cache_directory), "%s/cache", argv[1]);
    snprintf(cache, sizeof(cache), "%s/cache/vphoned", argv[1]);
    snprintf(pending, sizeof(pending), "%s/cache/pending", argv[1]);
    snprintf(marker, sizeof(marker), "%s/cache/marker", argv[1]);
    snprintf(alias, sizeof(alias), "%s/alias", argv[1]);
    snprintf(other, sizeof(other), "%s/other", argv[1]);
    assert(mkdir(cache_directory, 0700) == 0);
    assert(symlink(cache_directory, alias) == 0);
    write_file(cache); write_file(other);
    snprintf(executable, sizeof(executable), "%s/alias/vphoned", argv[1]);
    write_file(pending);
    vp_native_confirm_cached_binary();
    check(access(marker, F_OK) == 0 && access(pending, F_OK) != 0,
          "a running executable path alias confirms the actual pending marker");
    unlink(marker); unlink(pending);
    strcpy(executable, other); write_file(pending);
    vp_native_confirm_cached_binary();
    check(access(marker, F_OK) != 0 && access(pending, F_OK) == 0,
          "a different executable inode leaves the pending marker untouched");
    unlink(pending); strcpy(executable, cache);
    assert(symlink(cache, pending) == 0);
    vp_native_confirm_cached_binary();
    struct stat info;
    check(lstat(pending, &info) == 0 && S_ISLNK(info.st_mode) && access(marker, F_OK) != 0,
          "a symlink pending marker is refused");
    unlink(pending); unlink(marker); unlink(other); unlink(cache); unlink(alias); rmdir(cache_directory);
    printf("%d/%d production cached confirmation checks passed\n", checks - failures, checks);
    return failures ? 1 : 0;
}
