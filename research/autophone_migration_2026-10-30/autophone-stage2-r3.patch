+"""Explicit standalone stage-2 probes for a disposable, named upstream Rig.
+
+No default device, Control Plane fallback, protocol negotiation or write retry.
+"""
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+from pathlib import Path
+import socket
+import subprocess
+import time
+import uuid
+
+from autophone.device.session import probe_uds_state
+from autophone.device.shell import run_shell
+from autophone.device.target import VPhoneTarget, target_scope
+from autophone.device.uds import _check_peer_uid, request
+from autophone.rig.lifecycle import RigLifecycle
+from autophone.rig.target import DeviceTarget
+
+
+
+def paste_into_settings(send, output):
+    def rpc(method, params):
+        return send({"t": "rpc", "method": method, "params": params, "screen": False})
+    before = rpc("ui.tree", {"max_elements": 250})
+    fields = [item for item in before["result"]["elements"] if item.get("label") == "Search"]
+    if len(fields) != 1:
+        raise AssertionError("Settings Search field is not uniquely observable")
+    frame = fields[0]["frame"]
+    send({"t": "tap", "x": (frame["x"] + frame["width"] / 2) * 3,
+          "y": (frame["y"] + frame["height"] / 2) * 3, "screen": False})
+    token = "阶段二粘贴🌏é-" + uuid.uuid4().hex + "-文本" * 128
+    send({"t": "type", "text": token, "screen": False}, timeout=5)
+    clipboard = rpc("clipboard.get", {})
+    if clipboard["result"].get("text") != token:
+        raise AssertionError("Unicode clipboard mismatch before paste")
+    focus = rpc("ui.tree", {"max_elements": 250})
+    rpc("input.hid", {"page": 7, "usage": 227, "down": True})
+    try:
+        rpc("input.hid", {"page": 7, "usage": 4})
+        rpc("input.hid", {"page": 7, "usage": 25})
+    finally:
+        rpc("input.hid", {"page": 7, "usage": 227, "down": False})
+    observations = []
+    deadline = time.monotonic() + 8
+    while time.monotonic() < deadline:
+        tree = rpc("ui.tree", {"max_elements": 250})
+        observations.append(tree)
+        if any(item.get("label") == "Search" and item.get("value") == token
+               for item in tree["result"]["elements"]):
+            (output / "paste.json").write_text(json.dumps(
+                {"accepted": True, "text": token, "before": before, "focus": focus,
+                 "observations": observations}, ensure_ascii=False, indent=2) + "\n")
+            return {"characters": len(token), "input_value_verified": True}
+        time.sleep(.1)
+    (output / "paste.json").write_text(json.dumps(
+        {"accepted": False, "text": token, "before": before, "focus": focus,
+         "observations": observations}, ensure_ascii=False, indent=2) + "\n")
+    raise AssertionError("Settings input value does not equal pasted clipboard text")
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--target", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(argv)
+    target = DeviceTarget.load(args.target)
+    if target.protocol != "upstream_v1":
+        parser.error("this probe requires an explicit upstream_v1 target")
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    results = {"accepted": False, "target": target.public_dict(), "checks": []}
+    def check(name, function):
+        start = time.monotonic()
+        try:
+            value = function()
+            results["checks"].append({"name": name, "passed": True, "seconds": time.monotonic()-start, "value": value})
+        except (OSError, ValueError, RuntimeError, AssertionError, subprocess.SubprocessError) as exc:
+            results["checks"].append({"name": name, "passed": False, "seconds": time.monotonic()-start,
+                                      "error": f"{type(exc).__name__}: {exc}"})
+        (output / "result.json").write_text(json.dumps(results, ensure_ascii=False, indent=2)+"\n")
+        return results["checks"][-1]["passed"]
+    def send(message, timeout=15):
+        response, _sample = request(message, sock_path=str(target.socket), protocol="upstream_v1", timeout=timeout)
+        if response.get("ok") is not True:
+            raise RuntimeError(str(response))
+        return response
+    def require(condition, detail):
+        if not condition:
+            raise AssertionError(detail)
+        return detail
+    def shell(command, timeout_ms=30000, **options):
+        return run_shell(command, sock_path=str(target.socket), protocol="upstream_v1",
+                         timeout_ms=timeout_ms, **options)
+    lifecycle = RigLifecycle(target)
+    with target_scope(VPhoneTarget(target.cli_dir, target.vm_dir, target.socket, target.rig_id, protocol=target.protocol)):
+        started = False
+        try:
+            started = check("start", lambda: lifecycle.start(timeout_s=300).to_dict())
+            if not started:
+                return 1
+            check("unlock", lambda: send({"t": "rpc", "method": "screen.unlock", "params": {}, "screen": False}))
+            check("health", lambda: require(probe_uds_state(target.socket, protocol="upstream_v1")["state"] == "guest_ready", "guest_ready"))
+            check("capabilities", lambda: send({"t": "capabilities", "screen": False}))
+            def screenshot():
+                response = send({"t": "screenshot", "screen": True})
+                require("path" not in response, "screenshot unexpectedly saved a host path")
+                data = base64.b64decode(response["image"], validate=True)
+                (output / "screen.jpg").write_bytes(data)
+                return {"jpeg_sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}
+            check("screenshot_no_save_geometry", screenshot)
+            token = "stage2-中文-" + uuid.uuid4().hex
+            def clipboard():
+                send({"t": "type", "text": token, "screen": False}, timeout=5)
+                result = send({"t": "rpc", "method": "clipboard.get", "params": {}, "screen": False})
+                require(result.get("result", {}).get("text") == token, "guest clipboard round trip mismatch")
+                return {"text": token}
+            check("clipboard_round_trip", clipboard)
+            check("key_home", lambda: send({"t": "key", "name": "home", "screen": False}))
+            check("tap", lambda: send({"t": "tap", "x": 645, "y": 1398, "screen": False}))
+            check("swipe", lambda: send({"t": "swipe", "x1": 645, "y1": 2200, "x2": 645, "y2": 1000, "ms": 250, "screen": False}))
+            check("apps_list", lambda: {"count": len(send({"t": "app_list", "filter": "user", "screen": False})["apps"])})
+            check("apps_launch", lambda: send({"t": "app_launch", "bundle_id": "com.apple.Preferences", "screen": False}, timeout=30))
+            check("apps_foreground", lambda: require(send({"t": "app_foreground", "screen": False}).get("bundle_id") == "com.apple.Preferences", "Settings foreground verified"))
+            check("actual_unicode_paste", lambda: paste_into_settings(send, output))
+            check("apps_terminate", lambda: send({"t": "app_terminate", "bundle_id": "com.apple.Preferences", "screen": False}))
+            def volume_keys():
+                for name in ("volup", "voldown"):
+                    send({"t": "key", "name": name, "screen": False})
+                return {"keys": ["volup", "voldown"]}
+            check("volume_keys", volume_keys)
+            def power_key():
+                send({"t": "key", "name": "power", "screen": False})
+                deadline = time.monotonic() + 3
+                while time.monotonic() < deadline:
+                    info = send({"t": "rpc", "method": "device.info", "params": {}, "screen": False})["result"]
+                    if info["lock"]["screen_off"]:
+                        break
+                    time.sleep(.1)
+                else:
+                    raise AssertionError("power key did not turn screen off")
+                unlocked = send({"t": "rpc", "method": "screen.unlock", "params": {}, "screen": False})
+                require(unlocked["result"]["screen_off"] is False, "screen remained off after unlock")
+                return {"screen_off_after_power": True, "unlocked": True}
+            check("power_key_and_unlock", power_key)
+            def shell_cwd_stdin():
+                result = shell('printf "%s\\n" "$PWD"; if read input; then exit 99; else printf stdin-eof; fi', cwd="/var/jb/tmp")
+                require(result.code == 0 and result.stdout in {"/var/jb/tmp\nstdin-eof", "/private/var/jb/tmp\nstdin-eof"}, "cwd/stdin EOF contract mismatch")
+                return {"cwd_and_stdin": result.stdout}
+            check("shell_cwd_and_stdin_eof", shell_cwd_stdin)
+            def large_file():
+                local = output / "large-input.bin"
+                payload = bytes(range(256)) * 8192
+                local.write_bytes(payload)
+                path = "/var/jb/tmp/autophone-large-" + uuid.uuid4().hex
+                send({"t": "file_put", "path": path, "load": str(local), "perm": "644", "screen": False})
+                back = output / "large-returned.bin"
+                send({"t": "file_get", "path": path, "save": str(back), "screen": False})
+                require(back.read_bytes() == payload, "large transfer changed bytes")
+                return {"bytes": len(payload), "sha256": hashlib.sha256(payload).hexdigest(), "path": path}
+            check("large_file_path_transfer", large_file)
+            remote = "/var/jb/tmp/autophone-stage2-" + uuid.uuid4().hex
+            def files():
+                local = output / "helper.sh"
+                local.write_text("#!/var/jb/bin/sh\nprintf autophone-file-ok\n")
+                put = send({"t": "file_put", "path": remote, "load": str(local), "perm": "755"})
+                back = output / "helper-returned.sh"
+                send({"t": "file_get", "path": remote, "save": str(back)})
+                require(back.read_bytes() == local.read_bytes(), "file bytes changed")
+                result = shell(remote)
+                require(result.code == 0 and result.stdout == "autophone-file-ok", "755 helper could not execute")
+                return {"path": remote, "sha256": hashlib.sha256(back.read_bytes()).hexdigest(), "upload": put}
+            check("files_755_execute", files)
+            def shell_basic():
+                result = shell("printf '%s' \"$PPID\"; printf stderr >&2; exit 7")
+                require(result.stdout.strip().isdigit() and result.code == 7 and result.stderr == "stderr", "shell result contract mismatch")
+                return {"parent_pid": result.stdout, "exit_code": result.code}
+            check("shell_result", shell_basic)
+            def shell_cap():
+                result = shell("printf '%070000d' 0; printf '%070000d' 0 >&2", allow_truncated=True)
+                require(result.truncated and len(result.stdout) == 65536 and len(result.stderr) == 65536, "shell stream cap mismatch")
+                return {"stdout": len(result.stdout), "stderr": len(result.stderr), "truncated": result.truncated}
+            check("shell_caps", shell_cap)
+            def shell_timeout():
+                response = send({"t": "shell", "cmd": "/var/jb/usr/bin/sleep 60 & wait", "timeout_ms": 100, "screen": False}, timeout=5)
+                require(response.get("timed_out") is True and response.get("code") == 137, "shell timeout contract mismatch")
+                return {"exit_code": response["code"], "timed_out": True}
+            check("shell_timeout", shell_timeout)
+            def disconnect_cleanup():
+                marker = "/var/jb/tmp/autophone-cancel-" + uuid.uuid4().hex
+                command = f"/var/jb/usr/bin/sleep 60 & printf '%s:%s' \"$!\" \"$$\" > {marker}; wait"
+                connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+                connection.settimeout(3)
+                connection.connect(str(target.socket))
+                _check_peer_uid(connection)
+                try:
+                    payload = {"t": "rpc", "method": "shell.exec", "params": {"cmd": command, "timeout_ms": 10000}, "screen": False}
+                    connection.sendall(json.dumps(payload).encode() + b"\n")
+                    deadline = time.monotonic() + 3
+                    identities = None
+                    while time.monotonic() < deadline:
+                        try:
+                            file = send({"t": "file_get", "path": marker, "screen": False})
+                            identities = [int(x) for x in base64.b64decode(file["data_b64"]).decode().split(":")]
+                            break
+                        except RuntimeError:
+                            time.sleep(.05)
+                    require(identities is not None and len(identities) == 2, "shell process identities were not published")
+                    start = time.monotonic()
+                    send({"t": "ping", "screen": False}, timeout=3)
+                    send({"t": "app_list", "filter": "running", "screen": False}, timeout=3)
+                    send({"t": "screenshot"}, timeout=3)
+                    concurrent_seconds = time.monotonic()-start
+                    connection.setblocking(False)
+                    try:
+                        data = connection.recv(1, socket.MSG_PEEK)
+                    except BlockingIOError:
+                        data = None
+                    require(data is None, "long shell ended before concurrent probes finished")
+                finally:
+                    connection.close()
+                deadline = time.monotonic() + 5
+                while time.monotonic() < deadline:
+                    rows = send({"t": "rpc", "method": "processes.list", "params": {}, "screen": False})["result"]["processes"]
+                    if not any(row.get("pid") in identities for row in rows):
+                        return {"cleaned_pids": identities, "concurrent_probe_seconds": concurrent_seconds}
+                    time.sleep(.05)
+                raise AssertionError("disconnected shell left live or unreaped processes")
+            check("shell_disconnect_cleanup_and_concurrency", disconnect_cleanup)
+            from autophone.device.session import VPhoneDeviceSession
+            class StandaloneFence:
+                def check(self):
+                    # The CLI requires the explicit disposable target above;
+                    # it does not construct or claim an Assignment lease.
+                    return None
+            session = VPhoneDeviceSession(target, StandaloneFence())
+            check("runtime_identity", lambda: session.runtime_info(timeout_s=10))
+        finally:
+            if started:
+                check("stop", lambda: lifecycle.stop().to_dict())
+    results["accepted"] = all(item["passed"] for item in results["checks"])
+    (output / "result.json").write_text(json.dumps(results, ensure_ascii=False, indent=2)+"\n")
+    print(json.dumps({"accepted": results["accepted"], "output": str(output)}))
+    return 0 if results["accepted"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
