+"""Saved live regression for two explicitly named disposable upstream Rigs."""
+from __future__ import annotations
+
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import fcntl
+import json
+from pathlib import Path
+import subprocess
+import time
+import uuid
+
+from autophone.device.session import VPhoneDeviceSession, probe_uds_state
+from autophone.device.target import VPhoneTarget, VPhoneTargetBindingError, target_scope
+from autophone.device.uds import request
+from autophone.rig.lifecycle import RigLifecycle
+from autophone.rig.target import DeviceTarget
+
+
+class StandaloneFence:
+    def check(self):
+        return None
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--target', type=Path, required=True)
+    parser.add_argument('--peer', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args(argv)
+    targets = [DeviceTarget.load(args.target), DeviceTarget.load(args.peer)]
+    if any(t.protocol != 'upstream_v1' for t in targets):
+        parser.error('both targets must explicitly use upstream_v1')
+    if targets[0].vm_dir == targets[1].vm_dir or targets[0].expected_usb_udid == targets[1].expected_usb_udid:
+        parser.error('two independent VM identities are required')
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    result = {'accepted': False, 'checks': [], 'targets': [t.public_dict() for t in targets]}
+    lifecycles = [RigLifecycle(t) for t in targets]
+    started = [False, False]
+    def check(name, function):
+        begin = time.monotonic()
+        try:
+            value = function()
+            item = dict(name=name, passed=True, value=value)
+        except (OSError, ValueError, RuntimeError, AssertionError, subprocess.SubprocessError) as exc:
+            item = dict(name=name, passed=False, error=f'{type(exc).__name__}: {exc}')
+        item['seconds'] = time.monotonic() - begin
+        result['checks'].append(item)
+        (output / 'result.json').write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\n')
+        return item
+    def require(condition, detail):
+        if not condition:
+            raise AssertionError(detail)
+    def send(index, message, timeout=15):
+        response, _ = request(message, sock_path=str(targets[index].socket), protocol='upstream_v1', timeout=timeout)
+        if response.get('ok') is not True:
+            raise RuntimeError(str(response))
+        return response
+    def rpc(index, method, params):
+        return send(index, {'t': 'rpc', 'method': method, 'params': params, 'screen': False})['result']
+    def runtime(index):
+        return VPhoneDeviceSession(targets[index], StandaloneFence()).runtime_info(timeout_s=15)
+    def lock_available(index):
+        path = targets[index].vm_dir / '.autophone-launch.lock'
+        with path.open('a+b') as stream:
+            try:
+                fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except BlockingIOError:
+                return False
+            fcntl.flock(stream.fileno(), fcntl.LOCK_UN)
+            return True
+    try:
+        for i in range(2):
+            started[i] = check(f'start_{i}', lambda i=i: lifecycles[i].start(allow_multi_vm=True, timeout_s=300).to_dict())['passed']
+        if not all(started):
+            return 1
+        check('unlock_both', lambda: [rpc(i, 'screen.unlock', {}) for i in range(2)])
+        def identities():
+            rows = [runtime(i) for i in range(2)]
+            require(rows[0]['host']['pid'] != rows[1]['host']['pid'], 'host PID collision')
+            require(rows[0]['guest']['boot_id'] != rows[1]['guest']['boot_id'], 'guest boot identity collision')
+            require(all(not lock_available(i) for i in range(2)), 'launch lock not held')
+            return rows
+        before = check('independent_runtime_and_locks', identities)
+        def cross_binding():
+            t = targets[0]
+            with target_scope(VPhoneTarget(t.cli_dir, t.vm_dir, t.socket, t.rig_id, t.protocol)):
+                try:
+                    send(1, {'t': 'type', 'text': 'must-not-dispatch', 'screen': False})
+                except VPhoneTargetBindingError as exc:
+                    return {'refused': str(exc)}
+            raise AssertionError('cross-socket write was admitted')
+        check('bound_cross_socket_refusal', cross_binding)
+        def clipboard_isolation():
+            tokens = ['isolation-A-' + uuid.uuid4().hex, 'isolation-B-' + uuid.uuid4().hex]
+            for i in range(2):
+                send(i, {'t': 'type', 'text': tokens[i], 'screen': False})
+            read = [rpc(i, 'clipboard.get', {})['text'] for i in range(2)]
+            require(read == tokens, 'clipboard state crossed Rig sockets')
+            return {'text': read}
+        check('clipboard_isolation', clipboard_isolation)
+        def headless_capture():
+            cap = send(1, {'t': 'capabilities', 'screen': False})
+            require(cap.get('headless') is True, 'peer was not launched headless')
+            require(cap['commands']['screenshot'] is True, 'headless screenshot unavailable')
+            image = send(1, {'t': 'screenshot'})
+            require('path' not in image, 'headless screenshot saved a host path')
+            return {'headless': True, 'image_bytes_base64': len(image['image'])}
+        check('headless_screenshot', headless_capture)
+        def native_running_clone_refusal():
+            t = targets[1]
+            destination = 'must-refuse-running-' + uuid.uuid4().hex[:10]
+            command = [str(t.core_bundle / 'Contents/MacOS/vphone-cli'), 'vm', 'clone', '--library-root',
+                       str(t.vm_dir.parent), t.vm_dir.name, destination, '--new-identity']
+            process = subprocess.run(command, capture_output=True, text=True, timeout=10)
+            require(process.returncode != 0 and not (t.vm_dir.parent / destination).exists(), 'running clone was not refused')
+            return {'returncode': process.returncode, 'stdout': process.stdout, 'stderr': process.stderr}
+        check('native_running_disk_refusal', native_running_clone_refusal)
+        def stop_with_pending_request():
+            with ThreadPoolExecutor(max_workers=1) as pool:
+                future = pool.submit(send, 0, {'t': 'shell', 'cmd': '/var/jb/usr/bin/sleep 60', 'timeout_ms': 10000, 'screen': False}, 15)
+                time.sleep(.3)
+                require(not future.done(), 'shell request completed before stop; no pending-request evidence')
+                receipt = lifecycles[0].stop().to_dict()
+                started[0] = False
+                try:
+                    reply = future.result(timeout=16)
+                    outcome = {'response': reply}
+                except (OSError, ValueError, RuntimeError) as exc:
+                    outcome = {'error': f'{type(exc).__name__}: {exc}',
+                               'operation_may_continue': getattr(exc, 'operation_may_continue', None)}
+            require(lock_available(0), 'stopped Rig launch lock is held')
+            require(probe_uds_state(targets[0].socket, protocol='upstream_v1', timeout=1)['state'] == 'unreachable', 'stopped Rig is reachable')
+            require(probe_uds_state(targets[1].socket, protocol='upstream_v1', timeout=3)['state'] == 'guest_ready', 'peer health changed after stopping selected Rig')
+            holder = subprocess.run(['lsof', '-F', 'p', str(targets[0].vm_dir / 'Disk.img')], capture_output=True, text=True)
+            require(not holder.stdout.strip(), 'stopped disk still has holders')
+            return {'stop': receipt, 'pending_request': outcome, 'pending_before_stop': True, 'disk_holders': []}
+        check('stop_pending_request_preserves_peer', stop_with_pending_request)
+        def reconnect():
+            lifecycles[0].start(allow_multi_vm=True, timeout_s=300)
+            started[0] = True
+            after = runtime(0)
+            if before['passed']:
+                previous = before['value'][0]
+                require(previous['host']['pid'] != after['host']['pid'], 'host PID unchanged after restart')
+                require(previous['guest']['boot_id'] != after['guest']['boot_id'], 'guest boot ID unchanged after restart')
+            return after
+        check('reconnect_new_runtime_identity', reconnect)
+    finally:
+        for i in range(2):
+            if started[i]:
+                check(f'stop_{i}', lambda i=i: lifecycles[i].stop().to_dict())
+        def closeout():
+            holders = []
+            for i in range(2):
+                require(lock_available(i), f'Rig {i} launch lock remains held')
+                p = subprocess.run(['lsof', '-F', 'p', str(targets[i].vm_dir / 'Disk.img')], capture_output=True, text=True)
+                holders.append(p.stdout.strip())
+            require(not any(holders), 'disk holders remain')
+            return {'locks_released': True, 'disk_holders': holders}
+        check('closeout', closeout)
+    result['accepted'] = all(x['passed'] for x in result['checks'])
+    (output / 'result.json').write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\n')
+    print(json.dumps({'accepted': result['accepted'], 'output': str(output)}))
+    return 0 if result['accepted'] else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
