@@ -0,0 +1,64 @@
+import Darwin
+import Foundation
+
+@main
+struct HostAutomationIOTests {
+    static func pair() -> [Int32] {
+        var fds: [Int32] = [0, 0]
+        precondition(socketpair(AF_UNIX, SOCK_STREAM, 0, &fds) == 0)
+        var value: Int32 = 1
+        for fd in fds { precondition(setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &value, 4) == 0) }
+        return fds
+    }
+
+    static func main() {
+        var count = 0
+        do {
+            let fds = pair(); defer { fds.forEach { close($0) } }
+            let data = Data("{\"t\":\"中文\"}\n".utf8)
+            DispatchQueue.global().async {
+                for byte in data { var byte = byte; _ = Darwin.write(fds[1], &byte, 1) }
+            }
+            precondition(VPhoneHostAutomationIO.readCommand(from: fds[0])?.line == "{\"t\":\"中文\"}")
+            count += 1
+        }
+        do {
+            let fds = pair(); defer { fds.forEach { close($0) } }
+            let data = Data("{\"t\":\"tap\"}".utf8)
+            _ = data.withUnsafeBytes { Darwin.write(fds[1], $0.baseAddress, $0.count) }
+            shutdown(fds[1], SHUT_WR)
+            precondition(VPhoneHostAutomationIO.readCommand(from: fds[0]) == nil)
+            count += 1
+        }
+        do {
+            let fds = pair(); defer { fds.forEach { close($0) } }
+            DispatchQueue.global().async {
+                let data = Data(repeating: 0x61, count: (1 << 20) + 1) + [0x0A]
+                _ = VPhoneHostAutomationIO.write(data, to: fds[1], timeout: 1)
+                shutdown(fds[1], SHUT_WR)
+            }
+            // The writer itself substitutes a bounded JSON error for an
+            // oversized response rather than transmitting invalid JSON.
+            let line = VPhoneHostAutomationIO.readCommand(from: fds[0])!.line
+            precondition(line.contains("response exceeds"))
+            count += 1
+        }
+        do {
+            let fds = pair(); defer { fds.forEach { close($0) } }
+            let start = ProcessInfo.processInfo.systemUptime
+            precondition(VPhoneHostAutomationIO.readCommand(from: fds[0], timeout: 0.05) == nil)
+            precondition(ProcessInfo.processInfo.systemUptime - start < 0.5)
+            count += 1
+        }
+        do {
+            let fds = pair(); defer { fds.forEach { close($0) } }
+            var size: Int32 = 4096
+            precondition(setsockopt(fds[0], SOL_SOCKET, SO_SNDBUF, &size, 4) == 0)
+            let start = ProcessInfo.processInfo.systemUptime
+            precondition(!VPhoneHostAutomationIO.write(Data(repeating: 0x61, count: 1 << 20), to: fds[0], timeout: 0.05))
+            precondition(ProcessInfo.processInfo.systemUptime - start < 0.5)
+            count += 1
+        }
+        print("\(count) host I/O tests passed")
+    }
+}
diff --git a/VPhoneExecutable/VPhoneVirtualization/UI/VPhoneHostAutomationIO.swift b/VPhoneExecutable/VPhoneVirtualization/UI/VPhoneHostAutomationIO.swift
new file mode 100644
index 0000000..b58e926
--- /dev/null
+++ b/VPhoneExecutable/VPhoneVirtualization/UI/VPhoneHostAutomationIO.swift
@@ -0,0 +1,54 @@
+import Darwin
+import Foundation
+
+/// Bounded line I/O independent of the VM and its MainActor operations.
+enum VPhoneHostAutomationIO {
+    static let maximumLength = 1 << 20
+
+    private static func timeout(_ descriptor: Int32, _ option: Int32, until deadline: TimeInterval) -> Bool {
+        let remaining = deadline - ProcessInfo.processInfo.systemUptime
+        guard remaining > 0 else { return false }
+        let micros = max(1, Int(remaining * 1_000_000))
+        var value = timeval(tv_sec: micros / 1_000_000, tv_usec: Int32(micros % 1_000_000))
+        return setsockopt(descriptor, SOL_SOCKET, option, &value, socklen_t(MemoryLayout<timeval>.size)) == 0
+    }
+
+    static func readCommand(from descriptor: Int32, timeout seconds: TimeInterval = 15) -> (line: String, rest: Data)? {
+        guard seconds.isFinite, seconds > 0 else { return nil }
+        let deadline = ProcessInfo.processInfo.systemUptime + seconds
+        var accumulated = Data()
+        var buffer = [UInt8](repeating: 0, count: 4096)
+        while accumulated.count < maximumLength {
+            guard timeout(descriptor, SO_RCVTIMEO, until: deadline) else { return nil }
+            let count = read(descriptor, &buffer, buffer.count)
+            if count < 0, errno == EINTR { continue }
+            guard count > 0, accumulated.count + count <= maximumLength else { return nil }
+            accumulated.append(contentsOf: buffer[..<count])
+            if let newline = accumulated.firstIndex(of: 0x0A) {
+                guard let line = String(data: accumulated[..<newline], encoding: .utf8) else { return nil }
+                return (line, Data(accumulated[accumulated.index(after: newline)...]))
+            }
+        }
+        return nil
+    }
+
+    @discardableResult
+    static func write(_ response: Data, to descriptor: Int32, timeout seconds: TimeInterval = 15) -> Bool {
+        guard seconds.isFinite, seconds > 0 else { return false }
+        let data = response.count <= maximumLength ? response
+            : Data("{\"ok\":false,\"error\":\"response exceeds 1 MiB\"}\n".utf8)
+        let deadline = ProcessInfo.processInfo.systemUptime + seconds
+        return data.withUnsafeBytes { raw in
+            guard let base = raw.baseAddress else { return true }
+            var offset = 0
+            while offset < raw.count {
+                guard timeout(descriptor, SO_SNDTIMEO, until: deadline) else { return false }
+                let count = Darwin.write(descriptor, base.advanced(by: offset), raw.count - offset)
+                if count < 0, errno == EINTR { continue }
+                guard count > 0 else { return false }
+                offset += count
+            }
+            return true
+        }
+    }
+}
