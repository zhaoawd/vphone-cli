diff --git a/Tests/ForegroundUID/main.c b/Tests/ForegroundUID/main.c
new file mode 100644
index 0000000..5d3a405
--- /dev/null
+++ b/Tests/ForegroundUID/main.c
@@ -0,0 +1,60 @@
+// Host-side regression for the foreground-uid lookup guard: tvOS exports
+// xpc_user_sessions_get_foreground_uid but traps in it while user sessions are
+// off, so the guard must ask xpc_user_sessions_enabled first.
+#include "ForegroundUID.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+static bool sessionsOn;
+static int lookups;
+
+// Stands in for libxpc: like tvOS, it traps when sessions are off.
+static uint64_t lookup(uint64_t flags) {
+    (void)flags;
+    if (!sessionsOn) {
+        fprintf(stderr, "FAIL: lookup called while user sessions are off\n");
+        abort();
+    }
+    lookups++;
+    return 501;
+}
+
+static bool enabled(void) {
+    return sessionsOn;
+}
+
+static int failures;
+
+static void expect(bool condition, const char *what) {
+    if (!condition) {
+        fprintf(stderr, "FAIL: %s\n", what);
+        failures++;
+    }
+}
+
+int main(void) {
+    uint64_t uid = 0;
+
+    // iOS 15: no lookup at all.
+    expect(!icli_foreground_uid(NULL, enabled, &uid), "no lookup gives no uid");
+
+    // tvOS: lookup exported, sessions off. Must not reach the lookup.
+    sessionsOn = false;
+    lookups = 0;
+    expect(!icli_foreground_uid(lookup, enabled, &uid), "sessions off gives no uid");
+    expect(lookups == 0, "sessions off never calls the lookup");
+
+    // iOS 16 and later: sessions on.
+    sessionsOn = true;
+    uid = 0;
+    expect(icli_foreground_uid(lookup, enabled, &uid), "sessions on gives a uid");
+    expect(uid == 501 && lookups == 1, "sessions on returns the lookup's uid");
+
+    // A libxpc with the lookup but without the predicate keeps the old path.
+    uid = 0;
+    expect(icli_foreground_uid(lookup, NULL, &uid) && uid == 501, "no predicate keeps the lookup");
+
+    if (failures) return 1;
+    printf("foreground uid guard: ok\n");
+    return 0;
+}
diff --git a/docs/releases/0.8.6.md b/docs/releases/0.8.6.md
new file mode 100644
index 0000000..145d718
--- /dev/null
+++ b/docs/releases/0.8.6.md
@@ -0,0 +1,2 @@
+- Launchd service operations no longer crash on tvOS when looking up the foreground user. tvOS exports the lookup but traps when user sessions are disabled; icli now checks whether sessions are enabled before calling it. Systems without the lookup retain their existing fallback.
+- A host-side regression test checks that disabled user sessions never reach the lookup, and runs in the release workflow.
diff --git a/scripts/test-foreground-uid.sh b/scripts/test-foreground-uid.sh
new file mode 100755
index 0000000..24882e7
--- /dev/null
+++ b/scripts/test-foreground-uid.sh
@@ -0,0 +1,28 @@
+#!/bin/sh
+set -eu
+cd "$(dirname "$0")/.."
+# Host-side regression for the foreground-uid lookup on tvOS, where libxpc
+# exports xpc_user_sessions_get_foreground_uid but traps in it while user
+# sessions are off. Compiles the pure ForegroundUID.h against a stand-in that
+# traps the same way, then checks nothing reaches the lookup around it.
+work="$(mktemp -d)"
+trap 'rm -rf "$work"' EXIT
+xcrun clang -std=c11 -Wall -Wextra -Werror -ISources/IcliSystemPrivate \
+  Tests/ForegroundUID/main.c -o "$work/foreground-uid-tests"
+"$work/foreground-uid-tests"
+
+# Every use of the lookup goes through icli_foreground_uid: the symbol is only
+# ever resolved by name, never linked or called directly.
+direct="$(grep -rn 'xpc_user_sessions_get_foreground_uid' Sources | grep -v '^[^:]*:[0-9]*: *//' | grep -v 'dlsym(xpc, "xpc_user_sessions_get_foreground_uid")' || true)"
+if [ -n "$direct" ]; then
+  echo "FAIL: xpc_user_sessions_get_foreground_uid used outside the guarded dlsym:" >&2
+  echo "$direct" >&2
+  exit 1
+fi
+callers="$(grep -rn 'lookup(0)' Sources | grep -v 'ForegroundUID.h' || true)"
+if [ -n "$callers" ]; then
+  echo "FAIL: foreground-uid lookup called outside icli_foreground_uid:" >&2
+  echo "$callers" >&2
+  exit 1
+fi
+echo "foreground uid lookup: only through icli_foreground_uid"
