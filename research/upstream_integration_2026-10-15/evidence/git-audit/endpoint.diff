+        try VPhoneMachineTemplates.lock(key.identifier, in: fixture.library, wait: false).release()
+    }
+
+    // MARK: - Never booting
+
+    @Test func `a frozen template refuses to boot, by every route`() throws {
+        let fixture = try makeFixture()
+        defer { fixture.cleanUp() }
