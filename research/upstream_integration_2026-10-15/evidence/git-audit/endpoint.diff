+            }
+            let body = payload.subdata(in: bounds.lowerBound ..< bounds.upperBound + 1)
+            let headers = [
+                "Content-Length": "\(body.count)",
+                "Content-Range": "bytes \(bounds.lowerBound)-\(bounds.upperBound)/\(payload.count)",
+                "ETag": current,
