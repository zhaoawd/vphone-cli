diff --git a/VPhoneLaunchpad/VPhoneLaunchpad/Localizable.xcstrings b/VPhoneLaunchpad/VPhoneLaunchpad/Localizable.xcstrings
index ffe754d798718559ce9aaec1ecfb1cc964504bc1..2160406cbcb214262cac86b529af7197860165b7 100644
