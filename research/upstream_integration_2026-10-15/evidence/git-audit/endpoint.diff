+    "$launchpad/VPhoneLaunchpad/Command/VPhoneLaunchpadCommandLine.swift" \
+    "$launchpad/VPhoneLaunchpad/Machines/VPhoneLaunchpadMachine.swift" \
+    "$launchpad/VPhoneLaunchpad/Machines/VPhoneLaunchpadMachineBinding.swift" \
