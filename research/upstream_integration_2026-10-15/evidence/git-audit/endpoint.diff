+        }
+        do {
+            _ = try GuestSystemAppLocation(bundlePath: "/Applications/MobilePhone.app")
+        } catch {
+            check(error == .notInBundleContainer("/Applications/MobilePhone.app"), "Phone refused as not in a container")
+        }
