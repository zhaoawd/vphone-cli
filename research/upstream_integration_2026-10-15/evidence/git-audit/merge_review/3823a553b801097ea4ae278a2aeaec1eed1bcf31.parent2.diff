+    // MARK: - Zip
+
+    static var cloudManifest: [String: Any] { [
+        "ProductVersion": "26.4",
+        "ProductBuildVersion": "23E5207q",
+        "SupportedProductTypes": ["ComputeModule14,1"],
+        "BuildIdentities": [
