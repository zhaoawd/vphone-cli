+ struct Section { let name: String; let va: UInt64; let size: Int; let file: Int }
+ var segments: [Segment] = []
+ var sections: [Section] = []
+ var starts: Set<UInt64> = []
+ func check(_ p:Int,_ n:Int) throws { guard p>=0,n>=0,p<=data.count,n<=data.count-p else {throw InvalidImage(description:"out of bounds \(p), \(n)")} }
+ func word(_ p:Int) throws -> UInt32 {try check(p,4);return data.withUnsafeBytes{UInt32(littleEndian:$0.loadUnaligned(fromByteOffset:p,as:UInt32.self))}}
+ func quad(_ p:Int) throws -> UInt64 {try check(p,8);return data.withUnsafeBytes{UInt64(littleEndian:$0.loadUnaligned(fromByteOffset:p,as:UInt64.self))}}
