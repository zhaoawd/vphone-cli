+    if (vpIsPreferences(path))
+        vpLoadLibrary("prefs-fix", VP_PREFS_FIX);
     if (!vpInBootstrap && !vpIsAppPath(path))
         return;
+    // Every app gets the sign-in suppressor; it self-gates on the sign-in
