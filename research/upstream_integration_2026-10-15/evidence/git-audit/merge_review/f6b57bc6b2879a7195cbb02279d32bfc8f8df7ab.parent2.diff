+    if (vpIsAppPath(path))
+        vpLoadLibrary("signin-fix", VP_SIGNIN_FIX);
     if (vpIsAppPath(path) && dlopen(VP_AVFOUNDATION, RTLD_LAZY | RTLD_NOLOAD))
