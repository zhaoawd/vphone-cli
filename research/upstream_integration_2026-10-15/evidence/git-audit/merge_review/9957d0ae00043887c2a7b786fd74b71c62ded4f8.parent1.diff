+        VPhoneMachineTemplateRecord(
+            key: key,
+            created: Date(timeIntervalSince1970: 1_800_000_000),
+            builtWithBundleVersion: "2.8.0",
+            sourceMachine: source,
+            steps: steps,
+        )
+    }
