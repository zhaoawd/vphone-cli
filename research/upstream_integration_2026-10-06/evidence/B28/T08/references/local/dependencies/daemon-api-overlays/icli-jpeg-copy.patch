+// B22 VM acceptance: encoding the original screen-backed CGImage retained
+// display-sized allocations after its UIImage was released. Copy its pixels
+// into an independent bitmap before JPEG encoding. Repeated captures settle
+// after release; the pinned IcliKit orientation and quality policy stay here.
+static NSData *icliJPEGRepresentation(UIImage *image, CGFloat quality) {
+    CGImageRef original = image.CGImage;
+    if (!original) return nil;
+    size_t width = CGImageGetWidth(original), height = CGImageGetHeight(original);
+    if (!width || !height || width > SIZE_MAX / 4 || height > SIZE_MAX / (width * 4)) return nil;
+    CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
+    if (!space) return nil;
+    CGContextRef context = CGBitmapContextCreate(NULL, width, height, 8, width * 4,
+                                                space, (CGBitmapInfo)kCGImageAlphaPremultipliedLast);
+    CGColorSpaceRelease(space);
+    if (!context) return nil;
+    CGContextDrawImage(context, CGRectMake(0, 0, width, height), original);
+    CGImageRef copy = CGBitmapContextCreateImage(context);
+    CGContextRelease(context);
+    if (!copy) return nil;
+    UIImage *detached = [UIImage imageWithCGImage:copy scale:image.scale orientation:image.imageOrientation];
+    CGImageRelease(copy);
+    return UIImageJPEGRepresentation(detached, quality);
+}
