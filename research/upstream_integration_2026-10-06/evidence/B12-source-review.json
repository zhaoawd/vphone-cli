  "adaptations": {
    "T36": "Local authenticated API v1 instance_id/hash/generation; default-off direct boot flag; optional strict setup_pending decode; missing provider skips automatic work; shared host input queue; cancellation never undoes submitted RPC.",
    "T37": "Existing CLI Stop/SIGINT guest halt lifecycle retained; failed Stop no longer receives an extra Launchpad child SIGINT. Guest-first API path and disk-release/update coordination unaccepted.",
    "T39": "Classic request returns text and image bytes in one awaited exchange. Connection token replaces absent daemon instance for connection-local baselines, never reused after reconnect. Clipboard mutation revisions and Mac changeCount guard writes. API second image await and chord transfer remain pending.",
    "T40": "Read-only immutable byte/hash/file revision snapshot and same-size rewrite detection; no per-machine executable routing or binding persistence/migration/guest replacement.",
    "T46": "Local synchronous reader callback drained state plus bounded-display omitted count. POSIX read preserves live pipe delivery and returns read errors. No asynchronous writer/helper ACK, protocol-version or UI throughput claim."
  },
  "semantic_commit_ledger_changed": false,
  "new_kernel_patches": false,
  "independent_review": false,
  "self_review": [
    "Actual same-byte binding rewrite failed then corrected with mtime/ctime equality.",
    "Foundation upToCount delayed pipe callback until EOF: actual 2-second test failed; POSIX read correction passed.",
    "Closed FileHandle descriptor access raises NSException; descriptor is acquired while open and read-error fixture uses captured descriptor.",
    "Original failure-to-interrupt Launchpad test conflicts with corrected refusal behavior and was changed to explicit fixture cleanup."
