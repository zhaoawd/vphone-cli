+            }
+            XCTAssertEqual(counts.calls, 2); XCTAssertEqual(counts.bytes, 3)
+            XCTAssertGreaterThanOrEqual(fcntl(handle.fileDescriptor, F_GETFD), 0)
+            XCTAssertEqual(try Data(contentsOf: f.disk), f.original)
+        }
+    }
